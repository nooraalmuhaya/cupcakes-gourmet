# Copie este arquivo para backend/.env e ajuste os valores.
# NUNCA faça commit do arquivo .env real.

# --- Banco de dados MySQL (8.0.16 ou superior) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cupcakes_gourmet
DB_USER=root
DB_PASSWORD=CHANGE_ME

# Banco usado SOMENTE pelos testes automatizados (pytest).
# Precisa ser diferente de DB_NAME: os testes apagam os dados desse banco.
TEST_DB_NAME=cupcakes_gourmet_test

# --- Sessão ---
# Chave usada para assinar o cookie de sessão. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
# true somente quando publicado com HTTPS (RNF-10)
SESSION_HTTPS_ONLY=false

# --- Regras da loja ---
# Taxa de entrega fixa por pedido, em reais (RN-10)
TAXA_ENTREGA=8.00

# --- CORS (somente se o front-end rodar em outra porta, ex.: python -m http.server 5500) ---
# Lista separada por vírgulas
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
